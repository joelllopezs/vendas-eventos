{
  "name": "pdv-eventos",
  "private": true,
  "version": "1.0.0",
  "description": "PDV multiempresa para eventos",
  "workspaces": ["server", "web"],
  "engines": { "node": "22.x" },
  "scripts": {
    "dev:server": "npm run dev -w server",
    "dev:web": "npm run dev -w web",
    "build": "npm run build -w web && npm run build -w server",
    "start": "npm run start -w server",
    "migrate": "npm run migrate -w server",
    "create-platform-admin": "npm run create-platform-admin -w server",
    "test": "npm test -w server",
    "typecheck": "npm run typecheck -w server && npm run typecheck -w web"
  }
}
