# Copie para server/.env e ajuste. Nunca versione o .env real.
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# PostgreSQL 14+ (usuário com permissão de criar tabelas/funções/triggers)
DATABASE_URL=postgresql://pdv:TROQUE_ESTA_SENHA@127.0.0.1:5432/pdv_eventos
DB_POOL_MAX=10

# Cookie de sessão: "auto" (padrão) usa Secure só quando o acesso é por HTTPS — funciona em http://localhost e em produção HTTPS.
# Atrás de proxy HTTPS defina também TRUST_PROXY=true. Valores true/false forçam o comportamento.
COOKIE_SECURE=auto
# Atrás de proxy reverso (Nginx, Caddy, Render, Railway...): true para o IP/protocolo reais.
TRUST_PROXY=false
# Origens extras aceitas em requisições que alteram dados (separadas por vírgula). Normalmente vazio.
ALLOWED_ORIGINS=

SESSION_IDLE_HOURS=12
SESSION_ABSOLUTE_HOURS=72
MAX_FAILED_LOGINS=5
LOCK_MINUTES=10
RATE_LIMIT_LOGIN_MAX=20

# Reservas: intervalo do job de expiração e vida máxima de um carrinho (prazo padrão fica por empresa, em Configurações)
EXPIRY_JOB_INTERVAL_MS=10000
CART_MAX_LIFETIME_MINUTES=60

# Fuso usado nos relatórios por dia
APP_TIMEZONE=America/Sao_Paulo
